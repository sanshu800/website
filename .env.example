# Reygent — optional environment configuration.
# The application runs with none of these set; each one switches on an integration.

# Where the SQLite database lives. Defaults to ./data/reygent.db
# REYGENT_DATA_DIR=./data
# REYGENT_DB_PATH=./data/reygent.db

# Push inbound leads to a CRM or automation tool. Optional: without it every
# submission still lands in the admin inbox at /admin/enquiries, which is the
# source of truth. The delivery result is recorded per lead and shown there, so a
# failing webhook is visible rather than silent.
# CRM_WEBHOOK_URL=https://hooks.example.com/reygent/inbound
# CRM_WEBHOOK_TOKEN=
# Which submission kinds to forward. Defaults to lead forms only: a newsletter
# signup is not a lead. Use "all" to send everything, or name kinds, e.g.
# CRM_WEBHOOK_KINDS=audit,contact,careers
# The public host this build is for. Set it and `npm run build` refuses to build
# while placeholder clients/testimonials are still in the site; leave it unset for
# local work. Vercel sets VERCEL_URL automatically.
# REYGENT_LIVE_HOST=reygent.ai
# Override the guard above, for a staging site on a real domain.
# ALLOW_PLACEHOLDERS=1

# Payments (not implemented — see README "Needs real credentials")
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_CORE=
# STRIPE_PRICE_PRO=

# Transactional email (not implemented)
# SMTP_URL=
# EMAIL_FROM=hello@reygent.ai
